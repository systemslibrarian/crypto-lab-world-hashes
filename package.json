{
  "name": "crypto-lab-world-hashes",
  "version": "0.1.0",
  "private": true,
  "description": "World Hashes demo: SM3, Streebog, Kupyna, SHA-256, and SHA-3 — with an attack lab that runs a real Merkle-Damgard length-extension forgery against SM3 and SHA-256, shows the sponge and wide-pipe constructions holding against the same attempt, and searches for real truncated-digest collisions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemslibrarian/crypto-lab-world-hashes.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/systemslibrarian/crypto-lab-world-hashes/issues"
  },
  "homepage": "https://systemslibrarian.github.io/crypto-lab-world-hashes/",
  "dependencies": {
    "@li0ard/kupyna": "^0.1.3",
    "@li0ard/streebog": "^0.2.5",
    "@noble/hashes": "^2.2.0",
    "sm-crypto": "^0.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.12.1",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
